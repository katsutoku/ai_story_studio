SECRET_KEY=change-this-secret-key
# DATABASE_URL is optional. If unset, an absolute SQLite path under instance/ is used automatically.
# Use an absolute path if you do set this, e.g. sqlite:////absolute/path/to/instance/ai_story_studio.db
# DATABASE_URL=sqlite:///instance/ai_story_studio.db
CHAPTER_MD_DIR=data/chapters
CHARACTER_THUMBNAIL_DIR=data/character_thumbnails
CHARACTER_THUMBNAIL_MAX_SIZE_MB=5
LOG_DIR=data/logs

# 章生成画面で最初に選択されるAI（openai / gemini / claude / ollama）
DEFAULT_AI_PROVIDER=gemini

# --- ChatGPT (OpenAI) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# --- Gemini (Google) ---
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# --- Ollama（ローカル実行、APIキー不要） ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# 1回のAI呼び出しで生成できる最大トークン数（4プロバイダ共通）
# 章を長くしたい場合はこの値を大きくする。目安：日本語は1トークン≒1〜2文字程度。
# モデル側の上限を超える値を指定するとエラーになるので、大きくする場合は利用モデルの仕様を確認すること。
AI_MAX_OUTPUT_TOKENS=8192
